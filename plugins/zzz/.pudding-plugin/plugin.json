    {
      "name": "config.update",
      "title": "修改应用配置",
      "description": "修改一个应用配置中已存在的简单字段。只接受安全标量值；通知账号、密钥、路径、脚本、流水线与启动命令类字段一律拒绝。写入后回读核验并返回新 configHash；catalogHash 或 configHash 过期时返回冲突。",
      "inputSchema": {
        "type": "object",
        "properties": {

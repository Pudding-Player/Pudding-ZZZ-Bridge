    {
      "name": "api.invoke",
      "title": "提交或停止应用",
      "description": "向宿主提交运行一个已注册的非内部应用（method=run），或停止当前任务（method=stop）。run 只返回是否已提交（accepted），不代表执行完成；stop 核对停止状态，确认窗口内未停止则如实返回 unknown。必须携带最新的 catalogHash。",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "properties": {
              "method": {
                "const": "stop"
              },
              "catalogHash": {
                "type": "string"
              }
            },
            "required": [
              "method",
              "catalogHash"
            ],
            "additionalProperties": false
          },
          {
            "properties": {
              "method": {
                "const": "run"
              },
              "catalogHash": {
                "type": "string"
              },
              "appId": {
                "type": "string",
                "description": "来自 catalog.search 的应用 ID"
              },
              "instanceIdx": {
                "type": "integer",
                "description": "账号实例下标，来自目录实例列表"
              },
              "groupId": {
                "type": "string",
                "description": "应用组 ID，省略时为 one_dragon"
              }
            },
            "required": [
              "method",
              "catalogHash",
              "appId",
              "instanceIdx"
            ],
            "additionalProperties": false
          }
        ]
      },
      "method": "POST",
      "url": "http://127.0.0.1:23101/api/invoke",
      "headers": {
        "X-Pudding-Token": "${ENV:ZZZ_BRIDGE_TOKEN}"
      },
      "timeoutMs": 30000,
      "execution": {
        "effect": "gameWrite",
        "effectIsDynamic": false,
        "concurrencySafe": false,
        "risk": "high",
        "concurrency": "gameExclusive",
        "leaseScope": "game:zzz",
        "idempotency": "neverRetry",
        "cancellation": "cooperative",
        "verification": "state",
        "compensation": "none",
        "timeoutMs": 30000,
        "unattended": "forbidden",
        "maxResultChars": 8000,
        "modelUsage": "none",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "afterRead",
        "promptVisible": false
      }
    },
    {

          "path": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 8,
            "description": "仅沿静态字典成员逐层定位，不执行表达式或 getter"
          },
          "query": {
            "type": "string",
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "enum": [
              "missingCapability",
              "contractDrift",
              "unavailableCapability"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1000,
            "description": "本轮常规目录查询或接口失败的具体证据，不填泛泛探索理由"

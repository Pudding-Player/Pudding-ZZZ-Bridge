              "type": "string",
              "enum": [
                "context.state",
                "context.current",
                "context.lastRunResult",
                "context.lastApplicationResult",
                "context.ready",
                "instance.currentIdx"
              ]
            },
            "minItems": 1,
            "maxItems": 16
          }
        },
        "required": [
          "fields"
        ],
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23101/api/read",
      "headers": {
        "X-Pudding-Token": "${ENV:ZZZ_BRIDGE_TOKEN}"
      },
      "timeoutMs": 20000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "idempotency": "safeRetry",
        "cancellation": "reliable",
        "verification": "none",
        "compensation": "none",
        "timeoutMs": 20000,
        "unattended": "allowed",

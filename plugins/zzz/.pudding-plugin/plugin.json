          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          },
          "gapId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "description": "能力目录实际未命中、未适配或契约不可用时签发；仅有自填 evidence 不能放行动态写入"
          }
        },
        "required": [

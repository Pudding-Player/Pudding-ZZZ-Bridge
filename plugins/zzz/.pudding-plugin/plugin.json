{
  "schemaVersion": 1,
  "id": "zzz",
  "name": "绝区零一条龙反射桥",
  "version": "0.5.0",
  "description": "通过注入用户自己启动的绝区零一条龙 GUI 进程的原生 C++ 反射桥（127.0.0.1:23101），查询应用目录、读写已缓存配置，并按用户明确指令提交或停止自动化应用。桥只反射真实 ZContext，不自动运行任务。",
  "skills": [
    "./skills"
  ],
  "httpTools": [
    {
      "name": "status",
      "title": "桥与宿主状态",
      "description": "查询反射桥与绝区零一条龙宿主的整体状态：附着情况、实例列表、当前运行状态、最近运行结果与应用目录 hash。其余操作以本次返回的 catalogHash 作为乐观并发依据。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "method": "POST",
      "url": "http://127.0.0.1:23101/status",
      "headers": {
        "X-Pudding-Token": "${ENV:ZZZ_BRIDGE_TOKEN}"
      },
      "timeoutMs": 20000,
      "execution": {
        "effect": "readOnly",
        "effectIsDynamic": false,
        "concurrencySafe": true,
        "risk": "observe",
        "concurrency": "readParallel",
        "idempotency": "safeRetry",
        "cancellation": "reliable",
        "verification": "none",
        "compensation": "none",
        "timeoutMs": 20000,
        "unattended": "allowed",
        "maxResultChars": 12000,
        "modelUsage": "none",
        "deferred": true,
        "alwaysLoad": false,
        "exposure": "always",
        "promptVisible": false
      }
    },
    {

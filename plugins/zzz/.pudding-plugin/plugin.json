    {
      "name": "host.inspect",
      "title": "绝区零一条龙缺口诊断（非常规入口）",
      "description": "仅在本轮常规接口已有具体缺口时检查现场静态结构。不是常规准备步骤。需要动态补足时携带能力目录签发的 gapId，取得现场 memberId 后先预览；不求值 getter、不构造对象、不执行表达式。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "modules、context、module:<已加载业务模块> 或 instance:<业务模块.现存类名>"
